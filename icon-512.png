<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff59d" />
      <stop offset="30%" stop-color="#facc15" />
      <stop offset="70%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#001e3d" />
      <stop offset="50%" stop-color="#070f1e" />
      <stop offset="100%" stop-color="#000b18" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" rx="90" fill="url(#bgGrad)" />
  
  <!-- Outer Gold Border -->
  <rect x="10" y="10" width="492" height="492" rx="80" fill="none" stroke="url(#goldGrad)" stroke-width="12" />
  
  <!-- Inner Fine Gold Border -->
  <rect x="26" y="26" width="460" height="460" rx="68" fill="none" stroke="rgba(250,204,21,0.5)" stroke-width="3" />
  
  <!-- Swastik Symbol -->
  <text x="50%" y="115" text-anchor="middle" fill="url(#goldGrad)" font-family="sans-serif" font-size="64" font-weight="900">卐</text>
  
  <!-- SG Monogram -->
  <text x="50%" y="285" text-anchor="middle" fill="url(#goldGrad)" font-family="'Cinzel Decorative', Georgia, serif" font-size="195" font-weight="900" letter-spacing="-2">SG</text>
  
  <!-- SWASTIK GOLD Text -->
  <text x="50%" y="385" text-anchor="middle" fill="url(#goldGrad)" font-family="'Cinzel Decorative', Georgia, sans-serif" font-size="52" font-weight="900" letter-spacing="4">SWASTIK GOLD</text>
  
  <!-- JALORE BULLION Subtext -->
  <text x="50%" y="440" text-anchor="middle" fill="#cbd5e1" font-family="'Open Sans', Arial, sans-serif" font-size="26" font-weight="800" letter-spacing="6">JALORE BULLION</text>
</svg>
